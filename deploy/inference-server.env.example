# FinWave inference server — environment.
# Copy to /etc/finwave/inference-server.env (chmod 600) and fill in.

# Gates /models/* endpoints (register/list). Any strong random string; the
# export_and_register.py helper must send the same value as X-API-KEY.
FINWAVE_API_KEY=change-me-strong-random

# Where registered models are copied + persisted (survives restarts). On the big
# disk so it lives next to the pulled model artifacts.
FINWAVE_MODEL_STORE_PATH=/media/alex/Storage/finwave_models/_store
